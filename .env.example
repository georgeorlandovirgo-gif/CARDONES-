# On GitHub Pages, set NEXT_PUBLIC_STORE_DEMO=1 in the CI workflow. No real
# Supabase database or checkout endpoint is ever used in static demo mode.
NEXT_PUBLIC_SITE_URL=https://your-commercial-domain.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production server only: DO NOT prefix with NEXT_PUBLIC, commit, or expose
SUPABASE_SERVICE_ROLE_KEY=
# One or more Supabase Auth user UUIDs (not email addresses)
ADMIN_USER_IDS=
# REQUIRED for live orders: a secure random secret, at least 32 bytes
RATE_LIMIT_SECRET=
# Optional merchant notification. Do not use private personal credentials.
RESEND_API_KEY=
ORDER_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=
# Enable only after migration 004 and real upload/moderation checks on production.
TESTIMONIAL_SUBMISSIONS_ENABLED=false

# Private owner traffic reports (migration 005). Use a separate random secret.
TRAFFIC_ENABLED=false
TRAFFIC_SECRET=

# Required for live invoice generation and payment-proof submission (fail closed).
# Create a Turnstile widget restricted to the production hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=

# REQUIRED: choose only the header your hosting proxy OVERWRITES.
# Block direct origin access; never trust a visitor-supplied forwarding header.
# Examples depend on your host: cf-connecting-ip, x-forwarded-for, x-real-ip.
TRUSTED_CLIENT_IP_HEADER=
