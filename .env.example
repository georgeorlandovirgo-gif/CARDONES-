# Only set a real live URL once you own a domain or have deployed to Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project settings → API URL (safe to expose), and service role key (SERVER ONLY).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional private shop notification email (Resend requires a verified sending domain).
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_FROM_EMAIL=
# Optional public shop contact data, set only after owner confirmation.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=