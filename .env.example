# Real production website URL (demo URL set by GitHub workflow)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public Supabase project URL and anon/publishable API key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: set only on commercial hosting server, NEVER in client code
SUPABASE_SERVICE_ROLE_KEY=
# Recommended anti-spam system: configure site key AND server secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Private salt for server order-rate-limit hashes
ORDER_RATE_SALT=
# Optional owner email alert (verified Resend sender required)
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_FROM_EMAIL=
